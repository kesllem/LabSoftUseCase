
@model IEnumerable<PetShop.Models.ReservaServico>

@{
    ViewData["Title"] = "Reservas de Serviço";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1>Reservas de Serviço</h1>
            <p class="text-muted mb-0">Gerencie as reservas de atendimento.</p>
        </div>

        <a asp-controller="ReservaServico"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Nova reserva
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-bordered align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Código</th>
                                <th>Data/Hora</th>
                                <th>Valor</th>
                                <th>Status</th>
                                <th>Cliente</th>
                                <th>Veterinário</th>
                                <th>Ações</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Codigo</td>

                                    <td>@item.DataHora.ToString("dd/MM/yyyy HH:mm")</td>

                                    <td>@item.Valor.ToString("C")</td>

                                    <td>@item.StatusServico</td>

                                    <td>
                                        @(item.Cliente != null
                                                                        ? item.Cliente.Codigo.ToString()
                                                                        : item.ClienteId.ToString())
                                                                                                </td>

                                    <td>
                                        @(item.Veterinario != null
                                                                        ? item.Veterinario.Codigo.ToString()
                                                                        : item.VeterinarioId.ToString())
                            </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a asp-controller="ReservaServico"
                                               asp-action="Edit"
                                               asp-route-id="@item.Codigo"
                                               class="btn btn-sm btn-warning">
                                                Editar
                                            </a>

                                            <a asp-controller="ReservaServico"
                                               asp-action="Details"
                                               asp-route-id="@item.Codigo"
                                               class="btn btn-sm btn-info">
                                                Detalhes
                                            </a>

                                            <a asp-controller="ReservaServico"
                                               asp-action="Delete"
                                               asp-route-id="@item.Codigo"
                                               class="btn btn-sm btn-danger">
                                                Excluir
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                                }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            Nenhuma reserva de serviço cadastrada.
        </div>
    }
</div>
