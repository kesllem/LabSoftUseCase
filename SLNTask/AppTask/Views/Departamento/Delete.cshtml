@model AppTask.Models.Departamento

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>

@if (ViewBag.TemFuncionarios == true)
{
    <div class="alert alert-danger">
        Este departamento possui funcionários vinculados e não pode ser excluído. Mova os funcionários para outro departamento antes de excluir.
    </div>
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div>
    <h4>Departamento</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Descricao)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Descricao)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ativo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ativo)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        @if (ViewBag.TemFuncionarios != true)
        {
            <input type="submit" value="Delete" class="btn btn-danger" />
        }
        <text> | </text>
        <a asp-action="Index">Back to List</a>
    </form>
</div>