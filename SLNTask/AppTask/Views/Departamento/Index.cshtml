@model IEnumerable<AppTask.Models.Departamento>

@{
    ViewData["Title"] = "Departamentos";
}

<h1 class="mb-4">Lista de Departamentos</h1>

<p>
    <a href="/Departamento/Create" class="btn btn-success text-white">Novo</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Descrição</th>
            <th>Ativo</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Descricao</td>

                <td>@item.Ativo</td>

                <td>
                    <a href="/Departamento/Edit/@item.Id"
                       class="btn btn-primary btn-sm text-white">
                        Alterar
                    </a>

                    <a href="/Departamento/Details/@item.Id"
                       class="btn btn-success btn-sm text-white"
                       style="background-color: #006400;">
                        Detalhe
                    </a>

                    <!-- Botão que abre o modal -->
                    <button type="button"
                            class="btn btn-danger btn-sm text-white"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal"
                            data-id="@item.Id"
                            data-descricao="@item.Descricao">
                        Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>