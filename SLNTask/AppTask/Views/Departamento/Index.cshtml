@model IEnumerable<AppTask.Models.Departamento>

@{
    ViewData["Title"] = "Departamentos";
}

<div class="page-header">

    <div>

        <h1 class="page-title">
            Departamentos
        </h1>

        <p class="page-subtitle">
            @Model.Count() departamento(s) cadastrado(s)
        </p>

    </div>

    <a href="/Departamento/Create"
       class="btn-accent">
        ➕ Novo Departamento
    </a>

</div>


@if (!Model.Any())
{
    <div class="empty-state">

        <p>
            🏢 Nenhum departamento cadastrado ainda.
        </p>

        <a href="/Departamento/Create"
           class="btn-accent">
            ➕ Criar primeiro departamento
        </a>

    </div>
}
else
{
    <div class="card-grid">

        @foreach (var item in Model)
        {
            <div class="entity-card status-info">

                <div class="entity-card-header">

                    <h3 class="entity-card-title">
                        @item.Descricao
                    </h3>

                    <span class="status-badge status-info">
                        🏢 Departamento
                    </span>

                </div>


                <div class="entity-owner">

                    <span class="avatar-badge">
                        🏢
                    </span>

                    <span class="entity-owner-name">
                        @item.Descricao
                    </span>

                </div>


                <div class="meta-list">

                    <div class="meta-row">
                        📝 Descrição:
                        <strong>
                            @item.Descricao
                        </strong>
                    </div>

                    <div class="meta-row">
                        ⚡ Ativo:
                        <strong>
                            @item.Ativo
                        </strong>
                    </div>

                </div>


                <div class="entity-card-actions">

                    <a href="/Departamento/Details/@item.Id"
                       class="btn-pill btn-pill-ghost">
                        Abrir
                    </a>

                    <a href="/Departamento/Edit/@item.Id"
                       class="btn-pill btn-pill-accent">
                        Editar
                    </a>

                    <button type="button"
                            class="btn-pill btn-pill-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal"
                            data-id="@item.Id"
                            data-descricao="@item.Descricao">
                        Excluir
                    </button>

                </div>

            </div>
        }

    </div>
}


<!-- MODAL DE EXCLUSÃO -->

<div class="modal fade"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header bg-danger text-white">

                <h5 class="modal-title"
                    id="deleteModalLabel">
                    Confirmação de Exclusão
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                Deseja realmente excluir o departamento:

                <strong id="departamentoDescricao"></strong>?

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="modal-btn-cancel btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <form id="deleteForm"
                      method="post"
                      action="">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-danger">
                        Sim, Excluir
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        var deleteModal =
            document.getElementById('deleteModal');

        deleteModal.addEventListener(
            'show.bs.modal',
            function (event) {

                var button =
                    event.relatedTarget;

                var id =
                    button.getAttribute('data-id');

                var descricao =
                    button.getAttribute(
                        'data-descricao'
                    );

                var modalDescricaoSpan =
                    deleteModal.querySelector(
                        '#departamentoDescricao'
                    );

                modalDescricaoSpan.textContent =
                    descricao;

                var deleteForm =
                    deleteModal.querySelector(
                        '#deleteForm'
                    );

                deleteForm.action =
                    '/Departamento/Delete/' + id;
            }
        );

    </script>
}
