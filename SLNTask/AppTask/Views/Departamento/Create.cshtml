@model AppTask.Models.Departamento

@{
    ViewData["Title"] = "Novo Departamento";
}

<h1 class="mb-4">Cadastrar Novo Departamento</h1>

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <!-- Mostra erros de validação -->
            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="Descricao" class="form-label">
                    Descrição
                </label>

                <input asp-for="Descricao"
                       class="form-control"
                       placeholder="Digite a descrição do departamento" />

                <span asp-validation-for="Descricao"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <div class="form-check">

                    <input asp-for="Ativo"
                           class="form-check-input" />

                    <label asp-for="Ativo"
                           class="form-check-label">
                        Departamento Ativo
                    </label>

                </div>

                <span asp-validation-for="Ativo"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3 d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">
                    Salvar Departamento
                </button>

                <a href="/Departamento/Index"
                   class="btn btn-secondary">
                    Voltar para a Lista
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}