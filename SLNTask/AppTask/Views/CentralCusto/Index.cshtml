@model IEnumerable<AppTask.Models.CentralCusto>

@{
    ViewData["Title"] = "Centrais de Custo";
}

<div class="page-header">

    <div>

        <h1 class="page-title">
            Centrais de Custo
        </h1>

        <p class="page-subtitle">
            @Model.Count() central(is) de custo cadastrada(s)
        </p>

    </div>

    <a href="/CentralCusto/Create"
       class="btn-accent">
        ➕ Nova Central
    </a>

</div>


@if (!Model.Any())
{
    <div class="empty-state">

        <p>
            💰 Nenhuma central de custo cadastrada ainda.
        </p>

        <a href="/CentralCusto/Create"
           class="btn-accent">
            ➕ Criar primeira central
        </a>

    </div>
}
else
{
    <div class="card-grid">

        @foreach (var item in Model)
        {
            <div class="entity-card status-accent">

                <div class="entity-card-header">

                    <h3 class="entity-card-title">
                        @item.NomeCusto
                    </h3>

                    <span class="status-badge status-accent">
                        💰 Central
                    </span>

                </div>


                <div class="entity-owner">

                    <span class="avatar-badge">
                        💰
                    </span>

                    <span class="entity-owner-name">
                        @item.NomeCusto
                    </span>

                </div>


                <div class="meta-list">

                    <div class="meta-row">
                        💰 Nome:
                        <strong>
                            @item.NomeCusto
                        </strong>
                    </div>

                    <div class="meta-row">
                        🎯 Meta anual:
                        <strong>
                            @item.ValorAnualMeta
                        </strong>
                    </div>

                </div>


                <div class="entity-card-actions">

                    <a href="/CentralCusto/Details/@item.Id"
                       class="btn-pill btn-pill-ghost">
                        Abrir
                    </a>

                    <a href="/CentralCusto/Edit/@item.Id"
                       class="btn-pill btn-pill-accent">
                        Editar
                    </a>

                    <button type="button"
                            class="btn-pill btn-pill-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal"
                            data-id="@item.Id"
                            data-nome="@item.NomeCusto">
                        Excluir
                    </button>

                </div>

            </div>
        }

    </div>
}


<!-- MODAL DE EXCLUSÃO -->

<div class="modal fade"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header bg-danger text-white">

                <h5 class="modal-title"
                    id="deleteModalLabel">
                    Confirmação de Exclusão
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                Deseja realmente excluir a central de custo:

                <strong id="centralCustoNome"></strong>?

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="modal-btn-cancel btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <form id="deleteForm"
                      method="post"
                      action="">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-danger">
                        Sim, Excluir
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        var deleteModal =
            document.getElementById('deleteModal');

        deleteModal.addEventListener(
            'show.bs.modal',
            function (event) {

                var button =
                    event.relatedTarget;

                var id =
                    button.getAttribute('data-id');

                var nome =
                    button.getAttribute('data-nome');

                var modalNomeSpan =
                    deleteModal.querySelector(
                        '#centralCustoNome'
                    );

                modalNomeSpan.textContent =
                    nome;

                var deleteForm =
                    deleteModal.querySelector(
                        '#deleteForm'
                    );

                deleteForm.action =
                    '/CentralCusto/Delete/' + id;
            }
        );

    </script>
}
