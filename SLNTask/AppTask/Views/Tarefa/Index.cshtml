@model IEnumerable<AppTask.Models.Tarefa>

@{
    ViewData["Title"] = "Tarefas";

    string StatusClass(string status) => status?.Trim().ToLower() switch
    {
        "em andamento" => "status-warn",
        "concluída" or "concluida" or "finalizada" => "status-accent",
        "cancelada" => "status-danger",
        _ => "status-info"
    };

    string Iniciais(string? nome)
    {
        if (string.IsNullOrWhiteSpace(nome)) return "?";
        var partes = nome.Trim().Split(' ');
        return partes.Length > 1 ? $"{partes[0][0]}{partes[^1][0]}".ToUpper() : partes[0][0].ToString().ToUpper();
    }
}

<div class="page-header">
    <div>
        <h1 class="page-title">Tarefas</h1>
        <p class="page-subtitle">@Model.Count() tarefa(s) cadastrada(s)</p>
    </div>
    <a href="/Tarefa/Create" class="btn-accent">➕ Nova Tarefa</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <p>📋 Nenhuma tarefa cadastrada ainda.</p>
        <a href="/Tarefa/Create" class="btn-accent">➕ Criar a primeira tarefa</a>
    </div>
}
else
{
    <div class="card-grid">
        @foreach (var item in Model)
        {
            var statusClass = StatusClass(item.StatusTarefa);
            var prazoClass = item.Prazo?.Trim().ToLower() switch
            {
                "em atraso" => "prazo-atraso",
                "em dia" => "prazo-emdia",
                _ => ""
            };
            var prazoIcone = prazoClass == "prazo-atraso" ? "⚠️" : prazoClass == "prazo-emdia" ? "✅" : "⏳";

            <div class="entity-card @statusClass">
                <div class="entity-card-header">
                    <h3 class="entity-card-title">@item.Descricao</h3>
                    <span class="status-badge @statusClass">@item.StatusTarefa</span>
                </div>

                <div class="entity-owner">
                    <span class="avatar-badge">@Iniciais(item.Funcionario?.Nome)</span>
                    <span class="entity-owner-name">@(item.Funcionario?.Nome ?? "Sem responsável")</span>
                </div>

                <div class="meta-list">
                    <div class="meta-row">📅 Planejada: <strong>@item.DataPlanejada.ToString("dd/MM/yyyy")</strong></div>
                    <div class="meta-row">▶️ Iniciada: <strong>@(item.DataIniciada?.ToString("dd/MM/yyyy") ?? "—")</strong></div>
                    <div class="meta-row">✅ Finalizada: <strong>@(item.DataFinalizada?.ToString("dd/MM/yyyy") ?? "—")</strong></div>
                    <div class="meta-row @prazoClass">@prazoIcone Prazo: <strong>@item.Prazo</strong></div>
                </div>

                <div class="entity-card-actions">
                    <a href="/Tarefa/Details/@item.Codigo" class="btn-pill btn-pill-ghost">Abrir</a>
                    <a href="/Tarefa/Edit/@item.Codigo" class="btn-pill btn-pill-accent">Editar</a>
                    <button type="button" class="btn-pill btn-pill-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@item.Codigo" data-descricao="@item.Descricao">
                        Excluir
                    </button>
                </div>
            </div>
        }
    </div>
}

<!-- Modal de Confirmação de Exclusão -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirmação de Exclusão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Deseja realmente excluir a tarefa: <strong id="tarefaDescricao"></strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="modal-btn-cancel btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="deleteForm" method="post" action="">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Sim, Excluir</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var descricao = button.getAttribute('data-descricao');

            var modalDescricaoSpan = deleteModal.querySelector('#tarefaDescricao');
            modalDescricaoSpan.textContent = descricao;

            var deleteForm = deleteModal.querySelector('#deleteForm');
            deleteForm.action = '/Tarefa/Delete/' + id;
        });
    </script>
}