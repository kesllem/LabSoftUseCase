<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AppTask</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AppTask.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = (string?)ViewContext.RouteData.Values["controller"] ?? "";
    }

    <input type="checkbox" id="sidebar-toggle" class="sidebar-toggle-checkbox" hidden />
    <label for="sidebar-toggle" class="sidebar-overlay"></label>

    <div class="app-shell">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <span class="sidebar-brand-mark">✅</span>
                <span class="sidebar-brand-text">AppTask</span>
            </div>

            <nav class="sidebar-nav">
                <a class="sidebar-link @(currentController == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="sidebar-link-icon">🏠</span> Home
                </a>
                <a class="sidebar-link @(currentController == "Tarefa" ? "active" : "")" asp-area="" asp-controller="Tarefa" asp-action="Index">
                    <span class="sidebar-link-icon">📋</span> Tarefas
                </a>
                <a class="sidebar-link @(currentController == "Funcionario" ? "active" : "")" asp-area="" asp-controller="Funcionario" asp-action="Index">
                    <span class="sidebar-link-icon">👤</span> Funcionários
                </a>
                <a class="sidebar-link @(currentController == "Departamento" ? "active" : "")" asp-area="" asp-controller="Departamento" asp-action="Index">
                    <span class="sidebar-link-icon">🏢</span> Departamentos
                </a>
                <a class="sidebar-link @(currentController == "CentralCusto" ? "active" : "")" asp-area="" asp-controller="CentralCusto" asp-action="Index">
                    <span class="sidebar-link-icon">💰</span> Central de Custo
                </a>
                <a class="sidebar-link @(currentController == "Incidente" ? "active" : "")" asp-area="" asp-controller="Incidente" asp-action="Index">
                    <span class="sidebar-link-icon">⚠️</span> Incidentes
                </a>

                <div class="sidebar-divider"></div>

                <a class="sidebar-link @(currentController == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Sobre" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Sobre">
                    <span class="sidebar-link-icon">ℹ️</span> Sobre
                </a>
                <a class="sidebar-link @(currentController == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Privacy" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Privacy">
                    <span class="sidebar-link-icon">🔒</span> Privacy
                </a>
            </nav>

            <div class="sidebar-footer">© 2026 · AppTask</div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <label for="sidebar-toggle" class="sidebar-toggle-btn d-lg-none">☰</label>
            </header>

            <main class="app-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                &copy; 2026 - AppTask - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>