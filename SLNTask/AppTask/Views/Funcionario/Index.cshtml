@model IEnumerable<AppTask.Models.Funcionario>

@{
    ViewData["Title"] = "Funcionários";

    string Iniciais(string? nome)
    {
        if (string.IsNullOrWhiteSpace(nome))
            return "?";

        var partes = nome.Trim().Split(' ');

        return partes.Length > 1
            ? $"{partes[0][0]}{partes[^1][0]}".ToUpper()
            : partes[0][0].ToString().ToUpper();
    }
}

<div class="page-header">
    <div>
        <h1 class="page-title">Funcionários</h1>
        <p class="page-subtitle">
            @Model.Count() funcionário(s) cadastrado(s)
        </p>
    </div>

    <a href="/Funcionario/Create" class="btn-accent">
        ➕ Novo Funcionário
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <p>👤 Nenhum funcionário cadastrado ainda.</p>

        <a href="/Funcionario/Create" class="btn-accent">
            ➕ Cadastrar primeiro funcionário
        </a>
    </div>
}
else
{
    <div class="card-grid">

        @foreach (var item in Model)
        {
            <div class="entity-card status-info">

                <div class="entity-card-header">

                    <h3 class="entity-card-title">
                        @item.Nome
                    </h3>

                    <span class="status-badge status-info">
                        👤 Funcionário
                    </span>

                </div>

                <div class="entity-owner">

                    <span class="avatar-badge">
                        @Iniciais(item.Nome)
                    </span>

                    <span class="entity-owner-name">
                        @item.Nome
                    </span>

                </div>

                <div class="meta-list">

                    <div class="meta-row">
                        💼 Cargo:
                        <strong>@item.Cargo</strong>
                    </div>

                </div>

                <div class="entity-card-actions">

                    <a href="/Funcionario/Details/@item.Codigo"
                       class="btn-pill btn-pill-ghost">
                        Abrir
                    </a>

                    <a href="/Funcionario/Edit/@item.Codigo"
                       class="btn-pill btn-pill-accent">
                        Editar
                    </a>

                    <button type="button"
                            class="btn-pill btn-pill-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal"
                            data-id="@item.Codigo"
                            data-nome="@item.Nome">
                        Excluir
                    </button>

                </div>

            </div>
        }

    </div>
}


<!-- MODAL DE EXCLUSÃO -->

<div class="modal fade"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header bg-danger text-white">

                <h5 class="modal-title" id="deleteModalLabel">
                    Confirmação de Exclusão
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                Deseja realmente excluir o funcionário:

                <strong id="funcionarioNome"></strong>?

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="modal-btn-cancel btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <form id="deleteForm"
                      method="post"
                      action="">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-danger">
                        Sim, Excluir
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        var deleteModal =
            document.getElementById('deleteModal');

        deleteModal.addEventListener(
            'show.bs.modal',
            function (event) {

                var button =
                    event.relatedTarget;

                var id =
                    button.getAttribute('data-id');

                var nome =
                    button.getAttribute('data-nome');

                var modalNomeSpan =
                    deleteModal.querySelector(
                        '#funcionarioNome'
                    );

                modalNomeSpan.textContent =
                    nome;

                var deleteForm =
                    deleteModal.querySelector(
                        '#deleteForm'
                    );

                deleteForm.action =
                    '/Funcionario/Delete/' + id;
            }
        );

    </script>
}